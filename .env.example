CATALOG_MODE=live
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Optional locally; set your own public profile URL for APP_ENV=production.
UCP_AGENT_PROFILE_URL=
MODEL_API_KEY=
SHOPIFY_CATALOG_TOKEN=
TRY_ON_PROVIDER=muse-image
# Local operational metrics; the report command never makes model calls.
EVALUATION_ENABLED=1
EVALUATION_RUN=default

# Per session, rolling hour; retries count, reused previews do not.
GENERATION_LIMIT_PER_HOUR=100
